# iavega.fr — portail
# Certificats HTTPS obtenus automatiquement par Let's Encrypt.

www.iavega.fr, iavega.fr {

	encode zstd gzip

	# InfoPara, servi sous /infopara
	# handle_path retire le prefixe : l'appli recoit /sources, /export/..., etc.
	handle_path /infopara/* {
		reverse_proxy infopara:8000
	}

	# /infopara sans slash final -> redirection
	handle /infopara {
		redir * /infopara/ permanent
	}

	# Racine du domaine : a remplacer par le portail quand il existera
	handle {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><meta charset=utf-8><title>iavega.fr</title><p style='font-family:system-ui;padding:2rem'>iavega.fr — portail en construction.<br><a href='/infopara/'>Acceder a InfoPara</a></p>" 200
	}
}
